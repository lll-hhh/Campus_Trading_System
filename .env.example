# 凤凰汽配管理系统 - 环境变量配置示例

# 智谱AI配置 (可选, 用于AI智能定价功能)
# 获取方式: https://open.bigmodel.cn/
GLM_API_KEY=your_glm_api_key_here
GLM_MODEL=glm-4-flash

# 数据库配置
MYSQL_DSN=mysql+pymysql://root:campuswap_root@localhost:3306/campuswap
REDIS_URL=redis://localhost:6379/0

# 系统配置
PHOENIX_ENV=local
JWT_SECRET_KEY=phoenix-secret-key-change-me
CORS_ORIGINS=["http://localhost:5173"]
