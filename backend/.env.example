# 环境配置
CAMPUSWAP_ENV=development

# 数据库连接配置
MYSQL_DSN=mysql+pymysql://root:your_password@localhost:3306/campuswap
MARIADB_DSN=mysql+pymysql://root:your_password@localhost:3307/campuswap
POSTGRES_DSN=postgresql+psycopg://campuswap:your_password@localhost:5432/campuswap
SQLITE_DSN=sqlite:///./campuswap.db

# Redis配置
REDIS_URL=redis://localhost:6379/0

# JWT配置 (请修改为安全的随机字符串)
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256

# 智谱AI配置 (可选,用于AI功能)
GLM_API_KEY=your_glm_api_key_here
GLM_MODEL=glm-4-flash
